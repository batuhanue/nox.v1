{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A task created by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 20, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "duration": { "type": "string", "maxLength": 50 },
        "color": { "type": "string", "maxLength": 20 },
        "type": { "type": "string", "maxLength": 20 },
        "completed": { "type": "boolean" },
        "locationName": { "type": "string", "maxLength": 200 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["title", "date", "startTime", "endTime", "duration", "color", "type", "completed", "ownerId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks belonging to a specific user."
    }
  }
}
