rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Validation: Task
    function isValidTask(data) {
      return data.keys().hasAll(['title', 'date', 'startTime', 'endTime', 'duration', 'color', 'type', 'completed', 'ownerId', 'createdAt', 'updatedAt']) 
        && data.title is string && data.title.size() <= 500
        && data.date is string && data.date.size() <= 20
        && data.startTime is string && data.startTime.size() <= 20
        && data.endTime is string && data.endTime.size() <= 20
        && data.duration is string && data.duration.size() <= 50
        && data.color is string && data.color.size() <= 20
        && data.type is string && data.type.size() <= 20
        && data.completed is bool
        && ( !data.keys().hasAny(['locationName']) || (data.locationName is string && data.locationName.size() <= 200) )
        && ( !data.keys().hasAny(['subtasks']) || data.subtasks is list )
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Users Collection (Tasks Subcollection)
    match /users/{userId}/tasks/{taskId} {
      allow get: if isSignedIn() && request.auth.uid == userId && existing().ownerId == request.auth.uid;
      
      allow list: if isSignedIn() && request.auth.uid == userId && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isSignedIn() 
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid
        && isValidTask(incoming())
        && incoming().ownerId == existing().ownerId // Immutable
        && incoming().createdAt == existing().createdAt // Immutable
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'date', 'startTime', 'endTime', 'duration', 'color', 'type', 'completed', 'locationName', 'subtasks', 'updatedAt']);
        
      allow delete: if isSignedIn() 
        && request.auth.uid == userId 
        && existing().ownerId == request.auth.uid;
    }

    // Canvas Projects Collection
    match /users/{userId}/projects/{projectId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().createdAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
